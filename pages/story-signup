<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Follow the Story | Quiet Backyard Living</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4E1BHTRHF3"></script>
  <script>
   window.dataLayer = window.dataLayer || [];
   function gtag(){dataLayer.push(arguments);}
   gtag('js', new Date());
   gtag('config', 'G-4E1BHTRHF3');
  </script>
  <style>
    .story-signup-topbox {
      margin-top:1.1rem;
      background:#fffef9;
      border:1px solid #e4dccd;
      border-radius:18px;
      padding:1rem 1.05rem;
      box-shadow:0 10px 24px rgba(0,0,0,.04);
      max-width:720px;
    }
    .story-signup-topbox h2 {
      margin:.1rem 0 .45rem;
      line-height:1.08;
    }
    .story-signup-topbox p {
      margin:.25rem 0;
      color:#5d4a32;
    }
    .story-signup-form {
      display:flex;
      flex-wrap:wrap;
      gap:.75rem;
      margin-top:.9rem;
      align-items:center;
    }
    .story-signup-form input[type="email"] {
      flex:1 1 260px;
      min-width:220px;
      padding:.9rem 1rem;
      border:1px solid #d8c9b3;
      border-radius:999px;
      font:inherit;
      background:#fff;
    }
    .story-signup-form button {
      border:none;
      cursor:pointer;
    }
    .story-signup-message {
      margin-top:.85rem;
      font-size:.96rem;
      color:#5d4a32;
    }
    .story-signup-message.success { color:#2f6b47; }
    .story-signup-message.error { color:#8a3d2f; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <div class="nav-brand-wrap">
        <div class="brand">Quiet Backyard Living</div>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/pages/about.html">Meet the Crew</a>
        <a href="/pages/blog.html">Backyard Tips &amp; Ideas</a>
        <a href="/pages/projects.html">See the Projects</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="page-hero">
      <h1>Follow the Story</h1>
      <div class="story-signup-topbox">
        <h2>Get story updates by email</h2>
        <p>Get a simple heads-up when the next chapter goes live.</p>
        <form id="storySignupForm" class="story-signup-form">
          <input id="storySignupEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
          <button class="button cta-blue" type="submit">Follow the Story</button>
        </form>
        <p id="storySignupMessage" class="story-signup-message" aria-live="polite"></p>
        <p style="margin-top:.7rem; color:#5f6658;">No spammy flood, just an update when the story moves forward.</p>
      </div>
    </section>

    <section class="split section">
      <div>
        <p>If you want to follow the ongoing story as it unfolds, this is the easiest way to keep up. We usually add a new chapter every couple of weeks when life at the cabin gives us something worth sharing.</p>
        <p>You’ll get a simple heads-up when a new chapter goes live, along with the real version of what we’re building, fixing, messing up, learning from, and slowly turning into something better.</p>
      </div>
      <div>
        <img src="/assets/images/gallery/chapter23-dream.jpg" alt="Wide view of the cabin, deck, and yard after years of work and change">
      </div>
    </section>
  </main>

  <footer class="footer"><div class="container"><p><strong>Quiet Backyard Living</strong> — QuietBackyardLiving.com</p><div class="footer-socials"><a class="social-pill social-pill-facebook" href="https://www.facebook.com/profile.php?id=61576569227577" target="_blank" rel="noopener noreferrer"><span class="social-mark">f</span><span>Facebook</span></a><a class="social-pill social-pill-pinterest" href="https://www.pinterest.com/quietbackyardliving/" target="_blank" rel="noopener noreferrer"><span class="social-mark">P</span><span>Pinterest</span></a><a class="social-pill" href="/pages/contact.html"><span>Contact</span></a></div></div></footer>

  <script>
    const storySignupForm = document.getElementById('storySignupForm');
    const storySignupEmail = document.getElementById('storySignupEmail');
    const storySignupMessage = document.getElementById('storySignupMessage');

    storySignupForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      storySignupMessage.textContent = 'Signing you up...';
      storySignupMessage.className = 'story-signup-message';

      const submitButton = storySignupForm.querySelector('button[type="submit"]');
      submitButton.disabled = true;

      try {
        const response = await fetch('/.netlify/functions/resend-signup', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email: storySignupEmail.value,
            source: 'story-signup',
            signup_page: 'story-signup.html'
          })
        });

        const result = await response.json();
        storySignupMessage.textContent = result.message || 'Done.';
        storySignupMessage.className = response.ok && result.ok
          ? 'story-signup-message success'
          : 'story-signup-message error';

        if (response.ok && result.ok) {
          storySignupForm.reset();
        }
      } catch (error) {
        storySignupMessage.textContent = 'Something went wrong on our end. Please try again in a minute.';
        storySignupMessage.className = 'story-signup-message error';
      } finally {
        submitButton.disabled = false;
      }
    });
  </script>
</body>
</html>
