        "a_7": "Our watering lesson ",
        "span_7": "↓",
        "span_8": "Pick your main lane",
        "h2_1": "What do you",
        "em_2": "actually eat?",
        "p_3": "Choose a concept to picture the bed. This is a visual guide—not a precision spacing calculation.",
        "button_1": "Tomato & pepper",
        "button_2": "Salad",
        "button_3": "Salsa & sauce",
        "button_4": "Mixed family",
        "div_1": "8 feet ",
