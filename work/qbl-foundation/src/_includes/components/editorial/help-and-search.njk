{% from "components/editorial/cards.njk" import card, heading %}
<section class="qbl-section qbl-page-width" id="practical-library">{{ heading("For your own Happy Place", "Maybe We Can Help.", "/field-guide", "The practical library") }}<p class="qbl-section-intro">The growing guides are always here. So are the projects, wildlife ideas and useful tools. Start with what you need.</p><div class="qbl-grid qbl-grid--three">{% for id in heartbeat.featuredPractical %}{{ card(storyCards[id],"reference") }}{% endfor %}</div>
<div class="qbl-discovery"><div><span class="qbl-eyebrow">The whole QBL library</span><h3>Something on your mind?</h3><p>Tomatoes, trellises, squirrels, watering… there’s more to wander through.</p></div><form id="fg-search-form"><label for="fg-query">Search stories, guides and tools</label><div class="qbl-search-line"><input id="fg-query" type="search" placeholder="Try a project, plant or little visitor" autocomplete="off"><button type="submit">Find it <span aria-hidden="true">↗</span></button></div><p id="fg-search-status" role="status"></p><ul id="fg-search-results" hidden></ul><a class="qbl-text-action" href="/library">Browse the complete library <span aria-hidden="true">↗</span></a></form></div></section>
