{% from "components/editorial/cards.njk" import card, heading %}
<section class="qbl-section">{{ heading("This season’s reading / From our real projects", "A little wood. A little possibility.", "/topics/projects", "Explore the Workshop") }}<div class="qbl-grid qbl-grid--three">{% for id in heartbeat.featuredJourney %}{{ card(storyCards[id],"project") }}{% endfor %}</div><aside class="qbl-up-next"><div><span class="qbl-eyebrow">Looking ahead / Ideas, not reported results</span><h3>{{ heartbeat.upNext.title }}</h3><p>{{ heartbeat.upNext.text }}</p></div><div class="qbl-up-next-links">{% for id in heartbeat.upNext.links %}<a href="{{ storyCards[id].href | relatedUrl }}">{{ storyCards[id].title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div></aside></section>
