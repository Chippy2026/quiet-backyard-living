{% from "components/editorial/cards.njk" import card, heading %}
<div class="qbl-page-width"><header class="qbl-destination-opening"><span class="qbl-eyebrow">Making & learning / {{ heartbeat.label }}</span><h1>Explore<br><em>the Workshop.</em></h1><p>Wood, tools, and a reason to make something. Garden structures, wildlife builds, cabin jobs—and the things we learn along the way.</p></header></div>
<section class="qbl-workshop-feature qbl-page-width"><a href="{{ storyCards.trellis.href | relatedUrl }}"><figure>{{ storyCards.trellis.image | mediaImage | safe }}<figcaption>A real QBL build. From one cedar fence picket.</figcaption></figure><div><span class="qbl-eyebrow">A build to follow</span><h2>A little trellis.<br><em>A longer story.</em></h2><p>The pieces on the workbench. The finished fan. Then, out into the berry patch.</p><span class="qbl-text-action">Follow the build <span aria-hidden="true">↗</span></span></div></a></section>
<section class="qbl-section qbl-page-width">{{ heading("Things we’ve made / Not newly announced projects", "Useful things, made by hand.") }}<div class="qbl-grid qbl-grid--three">{% for id in ["birdhouse","feeder","playground","patio","deck","stairs"] %}{{ card(storyCards[id],"project") }}{% endfor %}</div></section>
<section class="qbl-notebook-band"><div class="qbl-page-width">{{ heading("From the workshop to our place", "See what happened next.") }}<div class="qbl-grid qbl-grid--two">{{ card(storyCards.installed,"small") }}{{ card(storyCards.grosbeak,"small") }}</div></div></section>
<section class="qbl-section qbl-page-width">{{ heading("Planning, experimenting, learning", "Not every idea starts with a saw.") }}<div class="qbl-grid qbl-grid--two">{{ card(storyCards.olla) }}{{ card(storyCards['garden-plan']) }}</div><a class="qbl-button" href="/library">Explore all projects and practical guides <span aria-hidden="true">↗</span></a></section>
