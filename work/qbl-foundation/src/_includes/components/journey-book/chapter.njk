{% set chapter=journey.book.byId[entry.id] %}
<article class="qj-chapter{% if chapter.originalLayout %} qj-original-page{% endif %}" data-pagefind-meta="kind:chapter">{% if chapter.originalLayout %}
<nav class="qj-original-back"><a class="qj-text-link" href="/our-journey/chapters#chapter-{{ chapter.chapterNumber }}">Back to The Chapters ↗</a><span>{{ chapter.dateLabel }}</span></nav>
<div class="qj-body qj-original-body">{% if chapter.originalHeadingAfterBlocks == 0 %}<span class="story-label">{{ chapter.originalChapterLabel }}</span><h1>{{ chapter.storyTitle }}</h1>{% endif %}{% for block in chapter.storyBlocks %}{{ block | chapterBlock | safe }}{% if loop.index == chapter.originalHeadingAfterBlocks %}<span class="story-label">{{ chapter.originalChapterLabel }}</span><h1>{{ chapter.storyTitle }}</h1>{% endif %}{% endfor %}</div>
{% else %}
<header class="qj-chapter-header"><a class="qj-text-link" href="/our-journey/chapters#chapter-{{ chapter.chapterNumber }}">Back to The Chapters <span aria-hidden="true">↗</span></a><span class="qj-kicker">Jeff & Vanessa’s journal / Chapter {{ chapter.chapterNumber }}</span><h1>{{ chapter.storyTitle }}</h1><p class="qj-date">{{ chapter.dateLabel }} · {{ chapter.readingMinutes }} minute read</p></header>
<div class="qj-body">{% for block in chapter.storyBlocks %}{{ block | chapterBlock | safe }}{% endfor %}</div>
{% endif %}
{{ chapter | signupForm | safe }}<footer class="qj-chapter-footer">{% if chapter.continuations.length %}<section><span class="qj-kicker">And then what happened?</span>{% for relation in chapter.continuations %}<a class="qj-continuation" href="{{ relation | relatedUrl }}"><span>{{ relation.context }}</span><strong>{{ relation.label }} <span aria-hidden="true">↗</span></strong></a>{% endfor %}</section>{% endif %}{% if chapter.relatedGuides.length %}<section><span class="qj-kicker">Want to try this yourself?</span>{% for relation in chapter.relatedGuides %}<a class="qj-continuation" href="{{ relation | relatedUrl }}"><span>{{ relation.context }}</span><strong>{{ relation.label }} <span aria-hidden="true">↗</span></strong></a>{% endfor %}</section>{% endif %}
{% if not chapter.next %}<div class="qj-caught-up"><h2>You’re all caught up.</h2><p>This is the latest recorded chapter, from {{ chapter.dateLabel }}. We’ll add what happened next when there’s a real next chapter to tell.</p><a class="qj-text-link" href="/notebook">Meanwhile, in the Notebook <span aria-hidden="true">↗</span></a></div>{% endif %}
<nav class="qj-reading-nav" aria-label="Read the chapters in order">{% if chapter.previous %}<a href="{{ chapter.previous.route }}"><span>← Previous Chapter {{ chapter.previous.chapterNumber }}</span><strong>{{ chapter.previous.storyTitle }}</strong></a>{% else %}<span class="qj-first-note">This is where the book begins.</span>{% endif %}<a class="qj-back-book" href="/our-journey/chapters#chapter-{{ chapter.chapterNumber }}">Back to<br>The Chapters</a>{% if chapter.next %}<a href="{{ chapter.next.route }}"><span>Next Chapter {{ chapter.next.chapterNumber }} →</span><strong>{{ chapter.next.storyTitle }}</strong></a>{% else %}<span class="qj-first-note">The next chapter is still to come.</span>{% endif %}</nav></footer></article>
