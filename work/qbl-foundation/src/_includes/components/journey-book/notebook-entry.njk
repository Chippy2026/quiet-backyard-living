<article class="qj-note"><header class="qj-opening"><a class="qj-text-link" href="/notebook">The Notebook <span aria-hidden="true">↗</span></a><span class="qj-kicker">{{ entry.noteLabel }}</span><h1>{{ entry.storyTitle }}</h1><p>{{ entry.description }}</p></header><figure>{{ entry.coverMedia | mediaImage | safe }}<figcaption>{{ entry.caption }}</figcaption></figure><div class="qj-note-body">{{ entry.noteHtml | safe }}<p class="qj-date">An excerpt from Chapter {{ journey.book.byId[entry.parentId].chapterNumber }}.</p><a class="qj-button" href="{{ journey.book.byId[entry.parentId].route }}">Read the whole chapter <span aria-hidden="true">↗</span></a></div></article>
