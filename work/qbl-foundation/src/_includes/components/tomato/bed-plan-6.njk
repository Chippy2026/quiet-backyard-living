<section class="tf-section tf-plan-section" id="bed-plan"><span id="pg-section-3" class="tf-anchor"></span><div class="tf-section-heading"><div><span class="tf-kicker">{{ block.copy.span_1 }}</span><h2>{{ block.copy.h2_1 }}<br><em>{{ block.copy.em_1 }}</em></h2></div><p>{{ block.copy.p_1 }}</p></div><div class="tf-plan-layout"><div class="tf-plan-visual"><div class="tf-plan-controls" role="group" aria-label="View the bed at different stages"><button type="button" data-bed-stage="early" aria-pressed="true" aria-controls="tomato-bed">{{ block.copy.button_1 }}</button><button type="button" data-bed-stage="later" aria-pressed="false" aria-controls="tomato-bed">{{ block.copy.button_2 }}</button></div><div class="tf-bed-topline">{{ block.copy.div_1 }}<span>{{ block.copy.span_2 }}</span></div><div id="tomato-bed" class="tf-bed" data-stage="early" role="img" aria-label="Conceptual bed: tomatoes own the central space, basil nearby, onions on the side, carrots in a separate pocket, flowers at the corners and lettuce along the early front edge."><span class="tf-bed-flower tf-flower-one" aria-hidden="true">{{ block.copy.span_3 }}</span><span class="tf-bed-flower tf-flower-two" aria-hidden="true">{{ block.copy.span_4 }}</span><div class="tf-bed-tomatoes"><div class="tf-canopy"><span class="tf-fruit"></span><span class="tf-fruit"></span><span class="tf-fruit"></span><strong>{{ block.copy.strong_1 }}</strong></div><div class="tf-canopy"><span class="tf-fruit"></span><span class="tf-fruit"></span><span class="tf-fruit"></span><strong>{{ block.copy.strong_2 }}</strong></div></div><div class="tf-bed-onions">{{ block.copy.div_2 }}</div><div class="tf-bed-basil">{{ block.copy.div_3 }}</div><div class="tf-bed-carrots">{{ block.copy.div_4 }}</div><div class="tf-bed-front"><span class="tf-early-label">{{ block.copy.span_5 }}</span><span class="tf-later-label">{{ block.copy.span_6 }}</span></div></div><p id="bed-stage-note" class="tf-bed-note" role="status">{{ block.copy.p_2 }}</p><p class="tf-caption">{{ block.copy.p_3 }}</p><noscript><p>{{ block.copy.p_4 }}</p></noscript></div><div class="tf-plan-copy"><h3>{{ block.copy.h3_1 }}</h3><ol><li><strong>{{ block.copy.strong_3 }}</strong>{{ block.copy.li_1 }}</li><li><strong>{{ block.copy.strong_4 }}</strong>{{ block.copy.li_2 }}</li><li><strong>{{ block.copy.strong_5 }}</strong>{{ block.copy.li_3 }}</li><li><strong>{{ block.copy.strong_6 }}</strong>{{ block.copy.li_4 }}</li></ol><a class="tf-button tf-button-solid" href="{{ block.links.link_1 | relatedUrl }}">{{ block.copy.a_1 }}<span aria-hidden="true">{{ block.copy.span_7 }}</span></a><a class="tf-button" href="{{ block.links.link_2 | relatedUrl }}">{{ block.copy.a_2 }}<span aria-hidden="true">{{ block.copy.span_8 }}</span></a></div></div></section>